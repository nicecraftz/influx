# Copy to .env and adjust. Both the app and docker-compose read this file.

# "development" (console + logs/influx.log) or "production" (everything to
# stderr, no file). The compose `app` service forces production.
INFLUX_ENV=development

# Database
DB_USER=influx
DB_PASSWORD=influx
DB_HOST=localhost
DB_PORT=5432
DB_NAME=influx

# Embedding (comando `embed`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_DIMENSIONS=768
CHUNK_OVERLAP_WORDS=50
# Generative model for enrichment (read by config, not used by any command yet)
OLLAMA_ENRICHMENT_MODEL=qwen3:8b

# API (JWT). The secret file is read at startup; `docker compose --profile api`
# mounts it from this same path.
JWT_ALGORITHM=HS256
JWT_SECRET_PATH=private_key.pem
JWT_TTL_MINUTES=30

# Host port of the API when running it with `docker compose --profile api`
APP_PORT=8000
